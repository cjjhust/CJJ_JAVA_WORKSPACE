# Local development values only. Replace before use outside a trusted dev machine.
POSTGRES_DB=audit_db
# Migration (DDL) account: Flyway connects with POSTGRES_USER/POSTGRES_PASSWORD.
POSTGRES_USER=audit_user
POSTGRES_PASSWORD=audit_password
FLYWAY_USER=${POSTGRES_USER}
FLYWAY_PASSWORD=${POSTGRES_PASSWORD}
# Runtime (DML) account, created by docker/postgres-init/01-create-audit-app.sql and
# granted least privilege by V2__grant_audit_app.sql. No DDL, no UPDATE/DELETE on audit_logs.
APP_DB_USER=audit_app
APP_DB_PASSWORD=audit_app_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password
APP_PORT=8081
AUDIT_CHAIN_HMAC_KEY=local-dev-only-change-before-deployment-2026-hmac-key
AUDIT_CHAIN_KEY_ID=local-dev-v1
