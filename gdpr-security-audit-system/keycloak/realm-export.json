{
  "realm": "audit-realm",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": false,
      "defaultAction": false
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": false,
      "defaultAction": false
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": false,
      "defaultAction": false
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": false,
      "defaultAction": false
    }
  ],
  "clients": [
    {
      "clientId": "audit-api",
      "name": "GDPR Audit API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "audit-api-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8081/*"],
      "webOrigins": ["http://localhost:8081"],
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8081/*"
      }
    }
  ],
  "roles": {
    "realm": [
      { "name": "ROLE_ADMIN", "description": "系统管理员，拥有所有权限" },
      { "name": "ROLE_AUDITOR", "description": "审计员，拥有查看审计日志的权限" },
      { "name": "ROLE_USER", "description": "普通用户，仅有基本操作权限" }
    ]
  },
  "users": [
    {
      "username": "admin-user",
      "email": "admin-user@example.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["ROLE_ADMIN"]
    },
    {
      "username": "auditor-user",
      "email": "auditor-user@example.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "auditor123", "temporary": false }
      ],
      "realmRoles": ["ROLE_AUDITOR"]
    },
    {
      "username": "regular-user",
      "email": "regular-user@example.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "user123", "temporary": false }
      ],
      "realmRoles": ["ROLE_USER"]
    }
  ]
}
