<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.aslp</groupId>
        <artifactId>smart-logistics-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>order-service</artifactId>
    <packaging>jar</packaging>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- P0-1：订单统一网关持久化（M1 承诺「统一 DTO 持久化至 PostgreSQL」） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- P1-2：Resilience4j（熔断 + 重试 + 舱壁）+ 降级回退；版本由 Spring Cloud BOM 管理 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
        <!-- Resilience4j 注解式切面（@CircuitBreaker/@Retry/@Bulkhead）需要 AOP 支持 -->
        <!-- P1-1：把 Resilience4j 的熔断/重试/舱壁状态导出为 Micrometer 指标
             （resilience4j_circuitbreaker_state / _calls_total …），供 Prometheus 抓取与 Grafana 出图 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- P0-4：Flyway 版本化迁移（替代 ddl-auto: update） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          P1-8：状态机持久化需要"真的写库"的测试（否则只能验证到"我调用了 save"）。
          H2 只用于测试内存库：@DataJpaTest 会用 H2 建表（由实体生成，不跑 Flyway 的 PG 方言脚本），
          从而能在单测里断言「新建一个 service 实例后状态仍是推进后的值」= 重启后状态不丢。
          inventory-service 早已采用同一做法（见其 pom）。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          P1-4 契约测试：用 WireMock 模拟 Amazon SP-API（LWA 换令牌 / 订单列表分页 /
          429 限流 / 503 / 超时 / 4xx），锁住「我们理解的平台契约」。
          选 standalone（shaded）版而不是普通版：普通版会带一套自己的 Jetty，
          与 spring-boot-starter-web 的 Tomcat/Jetty 版本容易相冲；
          standalone 把依赖全部 relocates 到 wiremock.* 包下，零冲突。
        -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>        <!-- P1-6：对象存储（面单/报关单 PDF）。用官方 MinIO Java SDK 而不是手写 S3 签名 ——
             签名/分页/预签名 URL 的细节太多，手写迟早踩坑。 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>
        <!-- P1-6：PDF 生成。选 OpenPDF（LGPL）而不是 iText 7（AGPL）：
             随货单据会被货代/海关接触，AGPL 会给公司带来不必要的许可证义务。 -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
