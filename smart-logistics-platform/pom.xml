<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>com.aslp</groupId>
    <artifactId>smart-logistics-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Smart Logistics Platform</name>
    <description>海外仓智能物流系统 — Maven 3.9+ / Maven 4.0 “高铁模式”</description>

    <modules>
        <module>gateway</module>
        <module>services/auth-service</module>
        <module>services/inventory-service</module>
        <module>services/order-service</module>
        <module>services/report-service</module>
        <module>services/route-service</module>
        <module>app-monolith</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!--
          Bug 修复：spring-cloud 2023.0.0（Leyton）仅兼容 Spring Boot 3.2.x，
          与 Boot 3.3.0 搭配时网关启动报：
            'Spring Boot [3.3.0] is not compatible with this Spring Cloud release train'
          2023.0.3 起官方允许 Boot 3.3.x。
        -->
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <maven.compiler.plugin.version>3.11.0</maven.compiler.plugin.version>
        <!--
          P2-7：Testcontainers 2.x。缺陷 #58 的根治方案：1.x 的 docker-java
          以 API 1.32 探测（Engine 29.x 最低 1.40），曾靠 docker-java.properties
          止血；2.x 自动协商 API 版本，止血贴已删除。
          注意 2.0 起构件名加 testcontainers- 前缀（junit-jupiter →
          testcontainers-junit-jupiter 等），Boot 3.3 BOM 不管理新名，
          因此这里直接导入 testcontainers-bom 管版本。
        -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- P1-4：契约测试用 WireMock（standalone 版，见 order-service 依赖注释） -->
        <wiremock.version>3.9.1</wiremock.version>
        <!-- P1-6：对象存储 SDK 与 PDF 生成（OpenPDF = LGPL，见 order-service 依赖注释） -->
        <minio.version>8.5.12</minio.version>
        <openpdf.version>2.0.3</openpdf.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- P2-7：Testcontainers 2.x BOM（Boot BOM 只管理 1.x 旧构件名，见上注释） -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      P1-1 可观测性：Prometheus 注册表属于“平台级关注点”（每个服务都要能被抓取），
      故声明在聚合 POM 的 <dependencies> 里由 6 个模块统一继承，避免在 6 个模块里重复声明。
      版本由 spring-boot-starter-parent 的 BOM 管理（无需写版本号）。
      各模块已各自声明 spring-boot-starter-actuator，用于暴露 /actuator/prometheus。
    -->
    <dependencies>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!--
          P1-3 链路追踪：Brave 桥接（Micrometer Tracing 的 Brave 实现）+ Zipkin 上报器。
          同样是平台级关注点（每个服务都要能产出/传播 traceId），故在此统一继承。
          W3C traceparent 为 Boot 3 默认传播格式，网关与下游服务需一致（否则跨服务串不起来）。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-reporter-brave</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!--
                          Bug 修复：maven-shared-incremental 的 stale 检测在 APFS
                          （1 秒时间戳粒度）上会误删刚生成的 .class 文件，导致
                          「主类编译成功但 surefire 报 NoClassDefFoundError」。
                          关闭增量编译检测，换取 100% 可重复构建（Reproducible Builds）。
                        -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- @{argLine} = JaCoCo prepare-agent 注入的 -javaagent（P0-3）；
                             直接写死 argLine 会把它覆盖，导致 .exec 不生成、覆盖率恒 0 -->
                        <argLine>@{argLine} -Xshare:off</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <!--
                      P0-3（verify 门禁引入后暴露）：repackage 默认把主构件替换成 fat jar
                      （业务类藏进 BOOT-INF/classes），下游 app-monolith 依赖它时
                      "程序包不存在"。classifier=exec 让 fat jar 变 *-exec.jar 副产物，
                      主构件保持薄 jar —— compose 的 Dockerfile COPY *.jar 需同步
                      改为 *-exec.jar（见根 Dockerfile）。
                    -->
                    <configuration>
                        <classifier>exec</classifier>
                    </configuration>
                </plugin>
                <!--
                  P0-3：JaCoCo 覆盖率门禁。每个模块 test 阶段出报告，
                  check 阶段执行门禁（LINE 60% / BRANCH 50%——对含大量 Testcontainers
                  集成测试与 WebFlux 配置类的工程，70% 起步会把合理代码判死）。
                  聚合报告由 report-aggregate 在最后一个模块出（见 app-monolith）。
                -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.12</version>
                    <executions>
                        <execution>
                            <goals><goal>prepare-agent</goal></goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals><goal>report</goal></goals>
                        </execution>
                        <execution>
                            <id>check</id>
                            <phase>verify</phase>
                            <goals><goal>check</goal></goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.60</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.50</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                                <!-- 纯配置类不计入门禁：安全链/WebFlux 装配的行为
                                     由集成测试与端到端断言验证（真 PG / 打网关断言 401/200），
                                     对它们做单测只是 mock 框架自身 -->
                                <excludes>
                                    <exclude>**/config/**</exclude>
                                    <exclude>**/*Config.class</exclude>
                                    <exclude>**/*Application.class</exclude>
                                </excludes>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- P0-3：激活 JaCoCo（版本与配置见 pluginManagement），全部模块统一继承 -->
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
