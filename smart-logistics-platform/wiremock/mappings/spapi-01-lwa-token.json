{
  "request": {
    "method": "POST",
    "urlPath": "/auth/o2/token",
    "headers": {
      "Content-Type": {
        "contains": "application/x-www-form-urlencoded"
      }
    },
    "bodyPatterns": [
      {
        "contains": "grant_type=refresh_token"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "at-wiremock-contract",
      "expires_in": 3600,
      "token_type": "Bearer"
    }
  }
}
